APP_NAME=PortalProveedores
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=America/Santiago

LOG_CHANNEL=stack
LOG_SLACK_WEBHOOK_URL=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portal_proveedores
DB_USERNAME=portal_user
DB_PASSWORD=CAMBIAR_ESTA_CLAVE

CACHE_DRIVER=file
QUEUE_CONNECTION=sync

FRONTEND_URL=http://localhost:5173/

JWT_SECRET=CAMBIAR_ESTE_SECRETO_LARGO_Y_ALEATORIO

AMLUPDATE_ENV=qa
AMLUPDATE_QA_BASE_URL=https://qa.amlupdate.com
AMLUPDATE_BASE_URL=https://www.amlupdate.com
AMLUPDATE_TOKEN=CAMBIAR_TOKEN_AMLUPDATE
AMLUPDATE_USER=CAMBIAR_USUARIO_AMLUPDATE

DICOM_BASE_URL=http://cobranza.dimerc.cl/v1/dicom
DICOM_TIMEOUT=30

MSAL_LOCAL_DEMO=false
PASSWORD_BCRYPT_COST=12
JWT_TTL_SECONDS=3600
# Plazo máximo por etapa del workflow (días corridos)
WORKFLOW_PLAZO_DIAS=3
# Re-evaluación periódica de proveedores aprobados
REEVALUACION_MESES=12
REEVALUACION_VIGENCIA_CONSULTAS_MESES=12
# Servicio simulado de SAP: true para simular un error técnico
SAP_MOCK_FORZAR_ERROR=false

# DICOM: real = cobranza.dimerc.cl (solo dentro de la red de Dimerc), simulado = respuestas de demostracion
DICOM_MODO=real

# Correo: smtp = envio real por SMTP (Mailpit en la demo), log = registro en storage/logs
MAIL_MODO=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_ENCRYPTION=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=portal@proveedores.local
MAIL_FROM_NAME="Portal de Proveedores"
PORTAL_URL=http://localhost:5173
