# ---------------------------------------------------------------
# Microsoft Entra ID (reemplazar por los datos de tu propio tenant)
# ---------------------------------------------------------------
# App registration del FRONTEND (SPA)
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# App registration de la API (scope expuesto: access_as_user)
VITE_AZURE_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# ---------------------------------------------------------------
# Backend del portal
# ---------------------------------------------------------------
VITE_PROVEEDORES_API_URL=http://localhost:8000/v1

# Modo local: muestra el aviso "Modo local" y omite la API corporativa Dimerc.
# Debe estar en false (o ausente) en cualquier entorno que no sea tu equipo.
VITE_LOCAL_DEMO=true
